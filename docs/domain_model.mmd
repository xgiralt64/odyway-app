classDiagram

%% Diagrama de Dominio OdyWay - Sprint 01

class User {
    +String id
    +String name
    +String username
    +String email
    +String profileImageUrl
    +register()
}

class AuthenticationService {
    +login(email, password)
    +logout()
    +resetPassword(email)
}

class Preferences {
    +String userId
    +Boolean isDarkMode
    +Boolean notificationsEnabled
    +String preferredLanguage
    +updatePreferences()
}

class Trip {
    +String id
    +String userId
    +String title
    +String destination
    +String status
    +LocalDate startDate
    +LocalDate endDate
    +Double budget
    +getRemainingBudget()
    +getTotalCost()
}

class Activity {
    +String id
    +String tripId
    +String title
    +String description
    +String location
    +Double cost
    +isFree()
}

class ItineraryItem {
    +String id
    +String tripId
    +LocalDate date
    +String time
    +String title
    +String location
    +Boolean isCompleted
    +toggleComplete()
}

class GalleryImage {
    +String id
    +String tripId
    +String imageUrl
    +String description
}

class Recommendation {
    +String id
    +String title
    +String description
    +String destination
}

%% Relacions

User "1" --> "1" Preferences : has
User "1" --> "many" Trip : owns
User "1" --> "1" AuthenticationService : uses
User "1" --> "many" Recommendation : receives

Trip "1" --> "many" Activity : manages expenses
Trip "1" --> "many" ItineraryItem : schedules
Trip "1" --> "many" GalleryImage : stores